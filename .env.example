# Copy to .env (git-ignored) and fill in to enable live analysis:
#     cp .env.example .env
#
# Without a key the app runs in FIXTURE mode: only the bundled synthetic sample
# clip can be analyzed, with simulated model replies. No calls are made.
#
# Get a key at https://app.vlm.run (Settings -> API keys). The key stays on the
# server: it is passed only to analysis worker processes, never to the browser,
# and is redacted from logs. An exported VLMRUN_API_KEY overrides this file.
VLMRUN_API_KEY=

# Optional
# SPORTS_HELPERS_MODE=fixture        # force fixture mode even with a key ("live" forces live)
# SPORTS_HELPERS_DATA=./data         # uploads, jobs, cache
# SPORTS_HELPERS_MAX_UPLOAD_MB=1024
# SPORTS_HELPERS_MAX_SECONDS=180     # longest clip (after trimming) sent for live analysis
# SPORTS_HELPERS_MAX_JOBS=2          # concurrent analysis processes
# HOST=127.0.0.1
# PORT=8000
